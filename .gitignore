# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
*.egg-info/
.venv/
venv/

# Node
node_modules/
.eslintcache

# Build outputs
dist/
build/pyinstaller-work/
build/backend-dist/
build/temp.linux-*/
build/temp.win-*/
build/temp.macosx-*/

# P4-T03: compiled C++ eval kernel (built via `npm run build:cpp`, never
# committed -- rebuild per machine/toolchain). setuptools --inplace drops
# these beside cpp_engine/__init__.py; the temp dirs land CWD-relative.
cpp_engine/*.so
cpp_engine/*.pyd
cpp_engine/build/

# Electron packager
dist/packages/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Secrets / local config
.env
*.local

# Local data
inspiration/
model_cache/

# Stockfish binaries the player drops in (100 MB+ each, never commit these)
# Ignore the *contents* of engines/, not the directory itself: a directory
# cannot be re-included once excluded, so 'engines/' would also block the
# .gitkeep below and force a separate negation that un-ignores the binaries.
engines/*
*.stockfish

# TypeScript test build output
dist-test/

# The engines folder ships (empty) with packaged builds so the path the
# resolver reads actually exists. Keep the folder, not its binaries.
!engines/.gitkeep

# Playwright e2e artifacts
test-results/
playwright-report/
blob-report/
.playwright/
